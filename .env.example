# ====================================================================
# Variáveis de Ambiente - Catálogo de Filmes Tom Hanks
# Disciplina do Professor @siriani
# ====================================================================

# Porta do container no Portainer / Subdomínio do aluno
PORT=3000
RESERVED_PORT=3000

# Chave de Desenvolvedor da API do TMDB
# Obtenha em: https://www.themoviedb.org/settings/api
TMDB_API_KEY=sua_chave_tmdb_aqui

# Configurações de Conexão com o Banco de Dados MariaDB da Disciplina
DB_HOST=mariadb
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha_mariadb_aqui
DB_NAME=filmes_db

# Segredo para assinatura de Tokens JWT de autenticação (OBRIGATÓRIO: mínimo 32 caracteres)
# Gere um segredo criptograficamente forte com: openssl rand -base64 64
JWT_SECRET=gere_uma_chave_criptograficamente_forte_com_no_minimo_32_caracteres

# URL pública da sua aplicação (exibida no link do e-mail de redefinição)
APP_URL=https://seu-subdominio.exemplo.com

# Envio de E-mails Reais via Brevo (Sendinblue)
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USER=seu_email_cadastrado_no_brevo@exemplo.com
MAIL_PASS=sua_chave_smtp_gerada_no_brevo
MAIL_FROM="Catálogo Tom Hanks <seu_email_cadastrado_no_brevo@exemplo.com>"

# Microserviço de Logs e Redis Streams (Atividade 5)
LOG_SERVICE_URL=http://log-service:3000
REDIS_URL=redis://redis:6379

# MinIO — Object Storage S3-compatível para fotos de perfil
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=perfil-fotos
MINIO_PUBLIC_URL=http://localhost:9000

