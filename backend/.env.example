# ==========================================
# Variáveis de Ambiente - Backend
# Catálogo de Filmes Tom Hanks - @siriani
# ==========================================

# Porta de execução da aplicação
PORT=3000
RESERVED_PORT=3000

# Chave de API do The Movie Database (TMDB)
# Obtenha gratuitamente em: https://www.themoviedb.org/settings/api
TMDB_API_KEY=sua_chave_tmdb_aqui

# Conexão com o Banco de Dados MariaDB da Disciplina
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha_aqui
DB_NAME=filmes_db

# Segredo para assinatura de Tokens JWT (OBRIGATÓRIO: mínimo 32 caracteres)
# Gere com: openssl rand -base64 64
JWT_SECRET=gere_uma_chave_criptograficamente_forte_com_no_minimo_32_caracteres
